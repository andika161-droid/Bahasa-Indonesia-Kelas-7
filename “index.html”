            }

            const item = shuffledQuizData[currentQuizIndex];
            if (selectedQuizOption === item.ans) {
                quizCorrectAnswers++;
            } else {
                quizWrongAnswers++;
            }

            currentQuizIndex++;
            if (currentQuizIndex < shuffledQuizData.length) {
                renderQuizQuestion();
            } else {
                finishQuiz();
            }
        }

        function finishQuiz() {
            clearInterval(quizTimerInterval);
            quizScore = Math.round((quizCorrectAnswers / shuffledQuizData.length) * 100);

            let category = "";
            if (quizScore >= 90) category = "Sangat Baik 🏆";
            else if (quizScore >= 80) category = "Baik 👍";
            else if (quizScore >= 70) category = "Cukup 👏";
            else category = "Perlu Belajar Lagi 📚";

            if (quizScore >= 80) playSound('win');

            const usedTime = 900 - quizTimeSeconds;
            const timeFormatted = `${Math.floor(usedTime / 60)} mnt ${usedTime % 60} dtk`;

            document.getElementById('res-score').innerText = quizScore;
            document.getElementById('res-category').innerText = category;
            document.getElementById('res-nama').innerText = activeStudent.nama;
            document.getElementById('res-kelas').innerText = activeStudent.kelas;
            document.getElementById('res-benar').innerText = quizCorrectAnswers;
            document.getElementById('res-salah').innerText = quizWrongAnswers;
            document.getElementById('res-persen').innerText = quizScore + "%";
            document.getElementById('res-waktu').innerText = timeFormatted;

            showView('view-hasil');
        }

        /* ==========================================================================
           10. METODE FETCH KIRIM DATA KE GOOGLE APPS SCRIPT
           ========================================================================== */
        function kirimKeGoogleSheets() {
            if (!GOOGLE_APPS_SCRIPT_URL || GOOGLE_APPS_SCRIPT_URL === "MASUKKAN_URL_GOOGLE_APPS_SCRIPT_DI_SINI") {
                alert("Hasil tetap tersimpan di perangkat. Hubungkan Google Spreadsheet untuk mengirim hasil kepada guru.");
                return;
            }

            const payload = {
                timestamp: new Date().toLocaleString("id-ID"),
                nama: activeStudent.nama,
                kelas: activeStudent.kelas,
                nilai: quizScore,
                benar: quizCorrectAnswers,
                salah: quizWrongAnswers,
                persentase: quizScore + "%",
                kategori: document.getElementById('res-category').innerText,
                waktu: document.getElementById('res-waktu').innerText
            };

            fetch(GOOGLE_APPS_SCRIPT_URL, {
                method: "POST",
                mode: "no-cors",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            })
            .then(() => alert("✅ Data hasil kuis berhasil dikirimkan ke Spreadsheet Guru!"))
            .catch(err => alert("⚠️ Gagal mengirim data: " + err));
        }

        /* ==========================================================================
           INITIALIZATION
           ========================================================================== */
        window.addEventListener('DOMContentLoaded', () => {
            loadSavedStudent();
            renderKenali();
            renderUnsur();
            renderLatihan();

            // Status Konfigurasi Guru
            document.getElementById('cfg-script-status').innerText = GOOGLE_APPS_SCRIPT_URL;
            document.getElementById('cfg-docs-status').innerText = GOOGLE_DOCS_URL;
        });
    </script>
</body>
