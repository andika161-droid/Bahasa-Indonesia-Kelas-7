            shuffledQuizData = shuffleArray(masterQuizData).map(item => {
                const shuffledOpt = shuffleArray(item.opt);
                return {
                    q: item.q,
                    opt: shuffledOpt,
                    ans: shuffledOpt.indexOf(item.opt[item.ans])
                };
            });

            currentQuizIndex = 0;
            quizScore = 0;
            quizCorrectAnswers = 0;
            quizWrongAnswers = 0;
            quizTimeSeconds = 900;

            showView('view-kuis');
            renderQuizQuestion();
            startTimer();
